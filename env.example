# Azure AI Foundry Instance 1 (OpenAI endpoint of the underlying AI Services account)
AZURE_OPENAI_ENDPOINT_1=https://<your-instance-1-custom-subdomain>.openai.azure.com/
AZURE_OPENAI_API_KEY_1=<your-instance-1-api-key>

# Azure AI Foundry Instance 2
AZURE_OPENAI_ENDPOINT_2=https://<your-instance-2-custom-subdomain>.openai.azure.com/
AZURE_OPENAI_API_KEY_2=<your-instance-2-api-key>

# Azure AI Foundry Instance 3
AZURE_OPENAI_ENDPOINT_3=https://<your-instance-3-custom-subdomain>.openai.azure.com/
AZURE_OPENAI_API_KEY_3=<your-instance-3-api-key>

# Azure OpenAI Instance 1 (kind: OpenAI)
AZURE_OAI_ENDPOINT_1=https://<your-oai-instance-1-custom-subdomain>.openai.azure.com/
AZURE_OAI_API_KEY_1=<your-oai-instance-1-api-key>

# Azure OpenAI Instance 2
AZURE_OAI_ENDPOINT_2=https://<your-oai-instance-2-custom-subdomain>.openai.azure.com/
AZURE_OAI_API_KEY_2=<your-oai-instance-2-api-key>

# Azure OpenAI Instance 3
AZURE_OAI_ENDPOINT_3=https://<your-oai-instance-3-custom-subdomain>.openai.azure.com/
AZURE_OAI_API_KEY_3=<your-oai-instance-3-api-key>

# Model deployment names (same across all instances)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4-1-mini
AZURE_OPENAI_DEPLOYMENT_NAME_2=gpt-5-mini
