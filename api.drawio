                <!-- Section A label -->
                <mxCell id="200" value="&lt;b style=&quot;font-size:13px;color:#107C10;&quot;&gt;A. Stateless — POST /chat/completions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;No server-side state. Can route to &lt;b&gt;any&lt;/b&gt; instance.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
