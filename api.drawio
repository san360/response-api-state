                <!-- Section B label -->
                <mxCell id="300" value="&lt;b style=&quot;font-size:13px;color:#D83B01;&quot;&gt;B. Stateful — GET /responses/{response_id}&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#444;&quot;&gt;response_id is &lt;b&gt;instance-bound&lt;/b&gt;. Must route to the &lt;b&gt;same&lt;/b&gt; Foundry instance.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
